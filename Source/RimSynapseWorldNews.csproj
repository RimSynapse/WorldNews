<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="GamePath.props" />

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>RimSynapseWorldNews</AssemblyName>
        <RootNamespace>RimSynapse</RootNamespace>
        <LangVersion>9.0</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>..\Assemblies\</OutputPath>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- ImageConversion.LoadImage (Texture2D extension) — decodes PNG bytes for newspaper art. -->
        <Reference Include="UnityEngine.ImageConversionModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(HarmonyPath)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        
        <!-- Reference Core Mod -->
        <Reference Include="RimSynapseCore">
            <HintPath>..\..\Core\Assemblies\RimSynapseCore.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- Regions and Territories is an OPTIONAL (soft) dependency: WorldNews reads territory,
             borders and regional belief from it to report the world map, but must load and run
             with it absent. Referenced for compile-time types only (Private=false so the DLL is
             not copied); every call into these types is gated behind RegionsAndTerritoriesBridge,
             which never touches an R&T type until it has confirmed the mod is loaded. About.xml
             declares loadAfter (not modDependencies) to match. -->
        <Reference Include="RimSynapseRegionsAndTerritories">
            <HintPath>..\..\Regions-and-Territories\Assemblies\RimSynapseRegionsAndTerritories.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="System.Net.Http" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- .NET Framework reference assemblies via NuGet: lets the build resolve net47x/net48
         from a restore, so only the .NET SDK is needed (no system-wide targeting pack). -->
    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>
